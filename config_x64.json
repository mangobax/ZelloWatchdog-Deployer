{
  "user": {
    "name": "radio",
    "password": "",
    "autoLogin": true
  },

  "remoteDesktop": {
    "enable": true,
    "disableNLA": true
  },

  "paths": {
    "documentsSubfolder": "ZelloWatchdog",
    "installFolder": "zello_watchdog"
  },

  "applications": {
    "zelloInstaller": "installers\\ZelloSetup_2_6_0.exe",
    "pythonInstaller": "installers\\python\\python-3.12.10-amd64.exe",
    "notepadPlusPlus": "installers\\notepad++\\npp.8.9.1.Installer.x64.exe",
    "nssm": "installers\\nssm\\win64\\nssm.exe"
  },

  "openssh": {
    "enable": true,
    "msi": "installers\\OpenSSH-Win64-v10.0.0.0.msi",
    "firewallProfile": "Private"
  },

  "support": {
    "enable": true,
    "accountName": "support",
    "passwordFile": "support\\support-password.txt",
    "publicKeyFile": "support\\support-key.pub"
  },

  "tailscale": {
    "enable": true,
    "installer": "installers\\tailscale-setup-1.86.2.exe",
    "authKey": "YOUR_TAILSCALE_AUTH_KEY_HERE",
    "hostname": ""
  },

  "service": {
    "name": "ZelloWatchdog",
    "pythonExe": "python.exe",
    "script": "zello_watchdog.py"
  },

  "power": {
    "sleep": 0,
    "hibernate": 0,
    "displayOffMinutes": 5,
    "wakeTimers": true
  },

  "environmentVariables": {
    "TELEGRAM_BOT_TOKEN": "YOUR_BOT_TOKEN_HERE",
    "TELEGRAM_CHAT_ID": "YOUR_CHAT_ID_HERE"
  }
}
